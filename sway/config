exec noctalia

# teclado
input * {
    xkb_layout "br"
}

# super
set $mod Mod4

# bordas
default_border pixel 2
default_floating_border pixel 2

# espaçamentos
gaps inner 8
gaps outer 8

# cores
client.focused #4c7899 #285577 #ffffff #2e9ef4 #2e9ef4

# atalhos
bindsym $mod+d exec noctalia msg panel-toggle launcher
bindsym $mod+q kill
bindsym $mod+Return exec foot
bindsym $mod+b exec librewolf
bindsym --to-code $mod+Shift+c reload
bindsym $mod+Shift+q exec loginctl terminate-user $USER
bindsym --to-code $mod+f fullscreen toggle
bindsym --to-code $mod+t floating toggle
floating_modifier $mod normal
bindsym --to-code $mod+e exec env EDITOR=vim foot yazi

# workspaces
bindsym --to-code $mod+1 workspace number 1
bindsym --to-code $mod+2 workspace number 2
bindsym --to-code $mod+3 workspace number 3
bindsym --to-code $mod+4 workspace number 4
bindsym --to-code $mod+5 workspace number 5
bindsym --to-code $mod+Shift+1 move container to workspace number 1
bindsym --to-code $mod+Shift+2 move container to workspace number 2
bindsym --to-code $mod+Shift+3 move container to workspace number 3
bindsym --to-code $mod+Shift+4 move container to workspace number 4
bindsym --to-code $mod+Shift+5 move container to workspace number 5

# janela em foco
bindsym --to-code $mod+h focus left
bindsym --to-code $mod+j focus down
bindsym --to-code $mod+k focus up
bindsym --to-code $mod+l focus right

# brilho (ddcutil) 
bindsym --to-code $mod+bracketleft exec $HOME/.config/sway/scripts/br -a 5
bindsym --to-code $mod+bracketright exec $HOME/.config/sway/scripts/br -d 5

# print (satty)
bindsym --to-code $mod+s exec $HOME/.config/sway/scripts/print
bindsym --to-code $mod+Mod1+s exec $HOME/.config/sway/scripts/print -s

# microfone (super+m muta/desmuta)
bindsym --to-code $mod+m exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

include ~/.config/sway/noctalia
